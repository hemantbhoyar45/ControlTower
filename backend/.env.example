# Copy these values into backend/.env before starting the backend.
CONTROL_TOWER_DATABASE_PATH=backend/data/control_tower.db
CONTROL_TOWER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_IDS=123456789,987654321
TELEGRAM_MODE=polling
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=your_optional_webhook_secret
